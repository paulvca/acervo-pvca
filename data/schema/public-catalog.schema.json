{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acervo PVCA public catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "slug",
      "title",
      "year",
      "directors",
      "countries",
      "poster",
      "copies",
      "catalog_copy_id",
      "external_links",
      "selections"
    ],
    "properties": {
      "added_at": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "original_title": {
        "type": ["string", "null"]
      },
      "romanized_title": {
        "type": ["string", "null"]
      },
      "year": {
        "type": "integer",
        "minimum": 1888,
        "maximum": 2100
      },
      "directors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "countries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "runtime_minutes": {
        "type": ["integer", "null"],
        "minimum": 1
      },
      "genres": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "synopsis": {
        "type": ["string", "null"]
      },
      "poster": {
        "type": "string",
        "minLength": 1
      },
      "copies": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "resolution",
            "size_gib",
            "audio_languages",
            "subtitle_languages"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": ["string", "null"]
            },
            "resolution": {
              "type": "string",
              "minLength": 1
            },
            "size_gib": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "audio_languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "subtitle_languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "edition": {
              "type": ["string", "null"]
            },
            "format": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        }
      },
      "catalog_copy_id": {
        "type": "string",
        "minLength": 1
      },
      "external_links": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "url"],
          "properties": {
            "provider": {
              "enum": ["internet_archive", "google_drive", "other"]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "copy_id": {
              "type": ["string", "null"]
            }
          }
        }
      },
      "collection_note": {
        "type": ["string", "null"]
      },
      "selections": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "original_languages": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "tmdb_id": {
        "type": ["integer", "null"],
        "minimum": 1
      },
      "imdb_id": {
        "type": ["string", "null"],
        "pattern": "^tt[0-9]+$"
      },
      "release_date": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "translations": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pt-BR": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": ["string", "null"]
              },
              "synopsis": {
                "type": ["string", "null"]
              },
              "collection_note": {
                "type": ["string", "null"]
              }
            }
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": ["string", "null"]
              },
              "synopsis": {
                "type": ["string", "null"]
              },
              "collection_note": {
                "type": ["string", "null"]
              }
            }
          }
        }
      },
      "localized_metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pt-BR": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "countries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "genres": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "original_languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "countries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "genres": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "original_languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
