{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acervo PVCA public catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "slug", "title", "year", "directors", "pt_br", "archive", "selections"],
    "properties": {
      "id": {"type":"string"},
      "slug": {"type":"string"},
      "title": {"type":"string"},
      "original_title": {"type":["string","null"]},
      "year": {"type":["integer","null"]},
      "directors": {"type":"array","items":{"type":"string"}},
      "countries": {"type":"array","items":{"type":"string"}},
      "poster": {"type":["string","null"]},
      "technical": {"type":"object","additionalProperties":false,"properties":{"resolution":{"type":["string","null"]}}},
      "audio_languages": {"type":"array","items":{"type":"string"}},
      "subtitle_languages": {"type":"array","items":{"type":"string"}},
      "pt_br": {"type":"boolean"},
      "archive": {
        "type":"object",
        "additionalProperties":false,
        "required":["available","url"],
        "properties":{
          "available":{"type":"boolean"},
          "url":{"type":["string","null"],"format":"uri"}
        }
      },
      "selections": {"type":"array","items":{"type":"string"}}
    }
  }
}
