{
  "name": "acervo-pvca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "admin": "node scripts/admin.mjs",
    "admin:test": "node --test scripts/admin.test.mjs",
    "presentation:test": "node --experimental-strip-types --test scripts/presentation.test.mjs",
    "data:test": "node --test scripts/database.test.mjs",
    "tmdb:test": "python3 scripts/tmdb_test.py",
    "catalog:check": "node scripts/catalog.mjs check",
    "catalog:import": "node scripts/catalog.mjs import",
    "catalog:test": "node --test scripts/catalog.test.mjs",
    "prepare": "husky",
    "catalog:prepare": "node scripts/prepare-canonical.mjs",
    "canonical:test": "node --test scripts/canonical.test.mjs",
    "site:sync": "node scripts/site-sync.mjs",
    "site:sync:test": "node --test scripts/site-sync.test.mjs"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
