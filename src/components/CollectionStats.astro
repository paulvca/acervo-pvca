---
import {getI18n,localizeFilm} from '../lib/i18n';
const {lang,t,path}=getI18n(Astro.url);

import {catalog as catalogPreview, isPreview} from '../data/catalog';
import {catalogCopy, hasPtBr} from '../lib/catalog';
import {selections} from '../data/selections';
const stats = [
 [catalogPreview.length, isPreview ? t('filmes nesta prévia') : t('filmes catalogados')],
 [catalogPreview.filter(hasPtBr).length, t('com legenda em português')],
 [catalogPreview.filter(film => catalogCopy(film)?.resolution === '2160p').length, t('em 2160p')],
 [catalogPreview.filter(film => catalogCopy(film)?.resolution === '1080p').length, t('em 1080p')],
 [selections.filter(selection => selection.films.length).length, t('seleções com filmes')],
];
---
<dl class="collection-stats">{stats.map(([value,label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
{isPreview && <p class="data-note">{t("Contagens dos registros desta prévia, não do acervo completo. Dados ausentes ainda não entram nas contagens técnicas.")}</p>}
