---
import { getI18n, localizeFilm, assetPath } from "../lib/i18n";
const { lang, t } = getI18n(Astro.url);

import type { CatalogPreviewFilm } from "../data/catalog-preview";
interface Props {
  film: CatalogPreviewFilm;
  eager?: boolean;
  decorative?: boolean;
}
const { eager = false, decorative = false } = Astro.props;
const film = localizeFilm(Astro.props.film, lang);
---

{film.poster ? (
  <img
    class="poster"
    src={assetPath(film.poster)}
    alt={decorative ? "" : `${t("Pôster de")} ${film.title}`}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    width="400"
    height="600"
  />
) : (
  <div
    class="poster poster-placeholder"
    role={decorative ? undefined : "img"}
    aria-hidden={decorative ? "true" : undefined}
    aria-label={
      decorative
        ? undefined
        : `${t("Pôster de")} ${film.title} ${t("ainda não importado")}`
    }
  >
    <span>{t("Pôster pendente")}</span>
  </div>
)}
