---
import {getI18n,localizeFilm,assetPath} from '../lib/i18n';
const {lang,t,path}=getI18n(Astro.url);

import type { CatalogPreviewFilm } from '../data/catalog-preview';
interface Props { film: CatalogPreviewFilm; eager?: boolean; }
const {eager=false}=Astro.props;
const film=localizeFilm(Astro.props.film,lang);
---
{film.poster ? <img class="poster" src={assetPath(film.poster)} alt={`${t("Pôster de")} ${film.title}`} loading={eager ? 'eager' : 'lazy'} decoding="async" width="400" height="600" /> : <div class="poster poster-placeholder" role="img" aria-label={`${t("Pôster de")} ${film.title} ${t("ainda não importado")}`}><span>{t("Pôster pendente")}</span></div>}
