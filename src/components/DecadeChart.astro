---
import { catalog } from "../data/catalog";
import { filmsByDecade } from "../lib/catalog";
import { getI18n } from "../lib/i18n";
const { t } = getI18n(Astro.url);
const decades = filmsByDecade(catalog);
const max = Math.max(1, ...decades.map((item) => item.count));
const midpoint = Math.ceil(decades.length / 2);
const groups = [decades.slice(0, midpoint), decades.slice(midpoint)].filter(
  (group) => group.length
);
---

{decades.length > 0 && (
  <div class="decade-chart">
    <h2>{t("Filmes por década")}</h2>
    <div class="histogram-panels">
      {groups.map((group) => (
        <ol class="columns" style={`--column-count:${group.length}`}>
          {group.map(({ decade, count }) => (
            <li>
              <span class="count">
                {count}
                <span class="sr-only">
                  {" "}
                  {t(count === 1 ? "filme" : "filmes")}
                </span>
              </span>
              <span class="column-track" aria-hidden="true">
                <span style={`--bar-size:${(count / max) * 100}%`}></span>
              </span>
              <span class="decade">{decade}</span>
            </li>
          ))}
        </ol>
      ))}
    </div>
  </div>
)}
<style>
  .decade-chart {
    font-variant-numeric: tabular-nums;
  }
  h2 {
    font-size: 20px;
    margin: 0 0 32px;
    color: var(--color-text-head);
  }
  .histogram-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(var(--column-count), minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .count {
    font-size: 16px;
    color: var(--color-text-head);
    margin-bottom: 12px;
  }
  .column-track {
    height: 200px;
    width: 100%;
    display: flex;
    align-items: end;
    border-bottom: 1px solid var(--color-border);
  }
  .column-track span {
    display: block;
    width: 100%;
    height: var(--bar-size);
    background: var(--color-text-muted);
    min-height: 0;
  }
  .decade {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-text-body);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .histogram-panels {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .columns {
      display: contents;
    }
    li {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) 30px;
      gap: 16px;
      align-items: center;
    }
    .decade {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      font-size: 14px;
    }
    .column-track {
      grid-column: 2;
      grid-row: 1;
      height: 12px;
      display: block;
      border: 0;
    }
    .column-track span {
      height: 100%;
      width: var(--bar-size);
    }
    .count {
      grid-column: 3;
      grid-row: 1;
      margin: 0;
      text-align: right;
      font-size: 14px;
    }
  }
</style>
