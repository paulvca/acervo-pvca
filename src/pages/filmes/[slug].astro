---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  catalogPreview,
  type CatalogPreviewFilm,
  type CatalogCopyInfo,
} from '../../data/catalog-preview';

export function getStaticPaths() {
  return catalogPreview.map((film) => ({
    params: { slug: film.slug },
    props: { film },
  }));
}

interface Props {
  film: CatalogPreviewFilm;
}

const { film } = Astro.props;

const headingMeta = [
  film.director,
  String(film.year),
  film.country,
].filter(Boolean).join(' · ');

const workRows = [
  ['Direção', film.director],
  ['Ano', String(film.year)],
  film.country && ['País', film.country],
  film.runtimeMinutes && ['Duração', `${film.runtimeMinutes} min`],
  film.genres?.length && ['Gênero', film.genres.join(', ')],
].filter(Boolean) as [string, string][];

const hasSelections = Boolean(film.selections?.length);
const hasEditorialSummary = Boolean(film.synopsis);
const copies = film.copies ?? [];
const publicAccess = film.publicAccess ?? [];
const hasMultipleCopies = copies.length > 1;

const formatGiB = (value: number) =>
  `${new Intl.NumberFormat('pt-BR', {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  }).format(value)} GiB`;

const copyRows = (copy: CatalogCopyInfo) => [
  copy.resolution && ['Resolução', copy.resolution],
  copy.sizeGiB != null && ['Tamanho', formatGiB(copy.sizeGiB)],
  copy.audio?.length && ['Áudio', copy.audio.join(', ')],
  copy.subtitles?.length && ['Legendas', copy.subtitles.join(', ')],
  copy.edition && ['Versão', copy.edition],
].filter(Boolean) as [string, string][];

const copyLabelForAccess = (copyId?: string) => {
  if (!copyId) return null;
  return copies.find((copy) => copy.id === copyId)?.label ?? null;
};
---

<BaseLayout
  title={`${film.title} — Acervo PVCA`}
  description={`${film.title}, ${film.director}, ${film.year} no Acervo PVCA.`}
>
  <Header active="films" />

  <main class="film-detail">
    <section class="wrap film-detail-head">
      <a class="back-link" href="/filmes/">← Filmes</a>

      <div class="film-title-block">
        <h1>{film.title}</h1>

        {
          (film.originalTitle || film.romanizedTitle) && (
            <p class="original-title">
              {[film.originalTitle, film.romanizedTitle]
                .filter(Boolean)
                .join(' · ')}
            </p>
          )
        }

        <p class="film-detail-meta">{headingMeta}</p>
      </div>
    </section>

    <section class="wrap film-hero">
      <div
        class="film-detail-poster"
        role="img"
        aria-label={`Espaço reservado para o pôster de ${film.title}`}
      ></div>

      <div class="film-work">
        {
          hasEditorialSummary && (
            <div class="film-synopsis">
              <p class="eyebrow">Sinopse</p>
              <p>{film.synopsis}</p>
            </div>
          )
        }

        <dl class:list={['film-core-facts', { 'without-synopsis': !hasEditorialSummary }]}>
          {
            workRows.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>

    <div class="wrap rule" aria-hidden="true"></div>

    <section class="wrap film-detail-section">
      <h2>No acervo</h2>

      {
        copies.length > 0 ? (
          <div class="film-copies">
            {
              copies.map((copy) => {
                const rows = copyRows(copy);

                return (
                  <article class="film-copy">
                    {
                      hasMultipleCopies && (
                        <h3>{copy.label}</h3>
                      )
                    }

                    {
                      rows.length > 0 ? (
                        <dl class="film-facts">
                          {
                            rows.map(([label, value]) => (
                              <>
                                <dt>{label}</dt>
                                <dd>{value}</dd>
                              </>
                            ))
                          }
                        </dl>
                      ) : (
                        <p class="copy-pending">
                          Dados técnicos da cópia ainda não importados.
                        </p>
                      )
                    }
                  </article>
                );
              })
            }
          </div>
        ) : (
          <p class="copy-pending">
            Dados da cópia ainda não importados.
          </p>
        )
      }
    </section>

    <div class="wrap rule" aria-hidden="true"></div>

    <section class="wrap film-detail-section film-access">
      <h2>Acesso</h2>

      {
        publicAccess.some((access) => Boolean(access.url)) ? (
          <div class="access-actions">
            {
              publicAccess
                .filter((access) => Boolean(access.url))
                .map((access) => (
                  <a
                    class="access-button"
                    href={access.url}
                    rel="external"
                  >
                    <span>{access.provider}</span>
                    <span aria-hidden="true">↗</span>
                    {
                      hasMultipleCopies &&
                      copyLabelForAccess(access.copyId) && (
                        <small>{copyLabelForAccess(access.copyId)}</small>
                      )
                    }
                  </a>
                ))
            }
          </div>
        ) : (
          <p class="no-public-access">Não há acesso público.</p>
        )
      }
    </section>

    {
      film.collectionNote && (
        <>
          <div class="wrap rule" aria-hidden="true"></div>

          <section class="wrap film-detail-section film-collection-note">
            <h2>Nota do acervo</h2>
            <p>{film.collectionNote}</p>
          </section>
        </>
      )
    }

    {
      hasSelections && (
        <>
          <div class="wrap rule" aria-hidden="true"></div>

          <section class="wrap film-detail-section">
            <h2>Também aparece em</h2>
            <div class="film-selection-links">
              {film.selections?.map((selection) => <span>{selection}</span>)}
            </div>
          </section>
        </>
      )
    }
  </main>

  <Footer />
</BaseLayout>
