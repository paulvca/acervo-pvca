---
import {getI18n,localizeFilm} from '../../lib/i18n';
const {lang,t,path}=getI18n(Astro.url);

import { catalog as catalogPreview } from '../../data/catalog';
import Poster from '../../components/Poster.astro';
import {formatGiB, distinctCopyDetails} from '../../lib/catalog';
import {selections} from '../../data/selections';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  type CatalogPreviewFilm,
  type CatalogCopyInfo,
} from '../../data/catalog-preview';

export function getStaticPaths() {
  return catalogPreview.map((film) => ({
    params: { slug: film.slug },
    props: { film },
  }));
}

interface Props {
  film: CatalogPreviewFilm;
}

const film=localizeFilm(Astro.props.film,lang);

const headingMeta = [
  film.director,
  String(film.year),
  film.country,
].filter(Boolean).join(' · ');

const workRows = [
  [t('Direção'), film.director],
  [t('Ano'), String(film.year)],
  film.country && [t('País'), t(film.country)],
  film.runtimeMinutes && [t('Duração'), `${film.runtimeMinutes} min`],
  film.genres?.length && [t('Gênero'), film.genres.map(t).join(', ')],
  film.originalLanguages?.length && [t('Idioma original'), film.originalLanguages.map(t).join(', ')],
].filter(Boolean) as [string, string][];

const hasSelections = selections.some(selection => selection.films.some(member => member.slug === film.slug));
const hasEditorialSummary = Boolean(film.synopsis);
const copies = distinctCopyDetails(film);
const externalLinks = film.externalLinks ?? [];
const hasMultipleCopies = copies.length > 1;

const copyRows = (copy: CatalogCopyInfo) => [
  [t('Resolução'), copy.resolution ?? t('Ainda não importada')],
  [t('Tamanho'), copy.sizeGiB != null ? formatGiB(copy.sizeGiB,lang) : t('Ainda não importado')],
  copy.format && [t('Formato'), copy.format],
  copy.audio?.length && [t('Áudio'), copy.audio.map(t).join(', ')],
  copy.subtitles?.length && [t('Legendas'), copy.subtitles.map(t).join(', ')],
  copy.edition && [t('Versão'), copy.edition],
].filter(Boolean) as [string, string][];

const copyLabelForAccess = (copyId?: string) => {
  if (!copyId) return null;
  return film.copies?.find((copy) => copy.id === copyId)?.label ?? null;
};
---

<BaseLayout
  title={`${film.title} — Acervo PVCA`}
  description={`${film.title}, ${film.director}, ${film.year} ${lang === "en" ? "in" : "no"} Acervo PVCA.`}
>
  <Header active="films" />

  <main id="main" class="film-detail">
    <section class="wrap film-detail-head">
      <a class="back-link" href={path("/filmes/")}>{t("← Filmes")}</a>

      <div class="film-title-block">
        <h1>{film.title}</h1>

        {
          (film.originalTitle || film.romanizedTitle) && (
            <p class="original-title">
              {[film.originalTitle, film.romanizedTitle]
                .filter(Boolean)
                .join(' · ')}
            </p>
          )
        }

        <p class="film-detail-meta">{headingMeta}</p>
      </div>
    </section>

    <section class="wrap film-hero">
      <Poster film={film} eager />

      <div class="film-work">
        {
          hasEditorialSummary && (
            <div class="film-synopsis">
              <p class="eyebrow">{t("Sinopse")}</p>
              <p>{film.synopsis}</p>
            </div>
          )
        }

        <dl class:list={['film-core-facts', { 'without-synopsis': !hasEditorialSummary }]}>
          {
            workRows.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>

    <div class="wrap rule" aria-hidden="true"></div>

    <section class="wrap film-detail-section">
      <h2>{t("No acervo")}</h2>

      {
        copies.length > 0 ? (
          <div class="film-copies">
            {
              copies.map((copy, index) => {
                const rows = copyRows(copy);

                return (
                  <article class="film-copy">
                    {
                      hasMultipleCopies && (copy.label || copy.edition || index > 0) && (
                        <h3>{copy.label || copy.edition || t("Outra cópia")}</h3>
                      )
                    }

                    {
                      rows.length > 0 ? (
                        <dl class="film-facts">
                          {
                            rows.map(([label, value]) => (
                              <>
                                <dt>{label}</dt>
                                <dd>{value}</dd>
                              </>
                            ))
                          }
                        </dl>
                      ) : (
                        <p class="copy-pending">{t("Dados técnicos da cópia ainda não importados.")}</p>
                      )
                    }
                  </article>
                );
              })
            }
          </div>
        ) : (
          <p class="copy-pending">{t("Dados da cópia ainda não importados.")}</p>
        )
      }
      {
        externalLinks.some((link) => Boolean(link.url)) && (
          <div class="access-actions film-public-links">
            {
              externalLinks
                .filter((link) => Boolean(link.url))
                .map((link) => (
                  <a
                    class="access-button"
                    href={link.url}
                    rel="external"
                  >
                    <span>{link.provider}</span>
                    <span aria-hidden="true">↗</span>
                    {
                      hasMultipleCopies &&
                      copyLabelForAccess(link.copyId) && (
                        <small>{copyLabelForAccess(link.copyId)}</small>
                      )
                    }
                  </a>
                ))
            }
          </div>
        )
      }

    </section>



    {
      film.collectionNote && (
        <>
          <div class="wrap rule" aria-hidden="true"></div>

          <section class="wrap film-detail-section film-collection-note">
            <h2>{t("Nota do acervo")}</h2>
            <p>{film.collectionNote}</p>
          </section>
        </>
      )
    }

    {
      hasSelections && (
        <>
          <div class="wrap rule" aria-hidden="true"></div>

          <section class="wrap film-detail-section">
            <h2>{t("Também aparece em")}</h2>
            <div class="film-selection-links">
              {selections.filter(selection => selection.films.some(member => member.slug === film.slug)).map(selection => <a href={path(`/selecoes/${selection.id}/`)}>{t(selection.localized?.[lang]?.title || selection.title)}</a>)}
            </div>
          </section>
        </>
      )
    }
  </main>

  <Footer />
</BaseLayout>
