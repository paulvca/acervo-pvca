---
import {getI18n} from '../../lib/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FilmCatalog from '../../components/FilmCatalog.astro';
import {catalog,isPreview} from '../../data/catalog';
const {t}=getI18n(Astro.url);
---
<BaseLayout title="Filmes — Acervo PVCA" description={t('Catálogo visual do Acervo PVCA.')}>
<Header active="films" /><main id="main"><FilmCatalog title={t('Filmes')} films={catalog} isPreview={isPreview} /></main><Footer />
</BaseLayout>
