---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Poster from '../components/Poster.astro';
import CollectionStats from '../components/CollectionStats.astro';
import {featuredFilm, recentFilms} from '../data/home';
import {selections} from '../data/selections';
---
<BaseLayout><Header active="home" /><main id="main">
<section class="wrap intro"><h1>Meu acervo pessoal de cinema.</h1><p>Filmes que fui reunindo, preservando, legendando e organizando ao longo do tempo.</p><p class="aside">Este site é uma forma simples de abrir parte dessa coleção para quem quiser explorar — sem transformar o acervo em uma plataforma impessoal.</p></section>
<div class="wrap rule"></div>
<section class="wrap section"><div class="section-title"><h2>Em destaque</h2><span>uma escolha do momento</span></div>
<div class="feature"><Poster film={featuredFilm} eager /><div class="feature-copy"><h3>{featuredFilm.title}</h3><p class="feature-meta">{featuredFilm.director} · {featuredFilm.year} · {featuredFilm.country}</p><p>{featuredFilm.collectionNote}</p><a class="inline-link" href={`/filmes/${featuredFilm.slug}/`}>Ver ficha →</a></div></div></section>
<div class="wrap rule"></div>
<section class="wrap section"><div class="section-title"><h2>Recentemente</h2><span>últimas adições e revisões</span></div><div class="recent-films">{recentFilms.map(film => <a href={`/filmes/${film.slug}/`}><Poster film={film} /><h3>{film.title}</h3><p>{film.director} · {film.year}</p></a>)}</div></section>
<div class="wrap rule"></div>
<section class="wrap section"><div class="section-title"><h2>Seleções</h2><span>algumas formas de atravessar o acervo</span></div><div class="home-selections">{selections.filter(selection => selection.films.length).slice(0,4).map(selection => <a href={`/selecoes/#${selection.id}`}><h3>{selection.title}</h3><p>{selection.description}</p><span>Ver seleção →</span></a>)}</div></section>
<div class="wrap rule"></div><section class="wrap section"><div class="section-title"><h2>O acervo</h2><span>alguns números</span></div><CollectionStats /></section>
</main><Footer /></BaseLayout>
