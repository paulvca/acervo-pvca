---
import { getI18n, assetPath } from "../lib/i18n";
const { t } = getI18n(Astro.url);

import { isPreview } from "../data/catalog";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CollectionStats from "../components/CollectionStats.astro";
---

<BaseLayout
  title="Sobre — Acervo PVCA"
  description={t(
    "Conheça a história e a organização do Acervo PVCA, minha coleção pessoal de cinema."
  )}
>
  <Header active="about" />
  <main id="main">
    <section class="wrap page-head">
      <h1>{t("Sobre")}</h1>
    </section>
    <div class="wrap about-intro">
      <p>
        {t(
          "Comecei o Acervo PVCA para organizar minha coleção de filmes. Com o tempo, a coleção passou a incluir diferentes cópias de cada obra, legendas revisadas e informações sobre os filmes."
        )}
      </p>
      <p>
        {t(
          "Você pode consultar a coleção neste site. As fichas trazem informações sobre os filmes e as cópias preservadas; minhas seleções reúnem obras por interesses em comum."
        )}
      </p>
    </div>
    <div class="wrap rule"></div>
    <div class="wrap about-columns">
      <section>
        <h2>{t("Os filmes e suas cópias")}</h2>
        <p>
          {t(
            "Na ficha de cada filme, você encontra direção, ano, país e duração. Ela também informa resolução, tamanho, áudio e legendas da cópia preservada. Se o acervo tem outras versões ou edições, os detalhes ficam na mesma página."
          )}
        </p>
        <p>
          {t("Os links disponíveis levam às cópias que escolhi compartilhar.")}
          {isPreview &&
            t(
              " Nesta prévia, pôsteres e dados ainda não importados permanecem indicados como pendentes."
            )}
        </p>
      </section>
      <section>
        <h2>{t("Minhas redes sociais")}</h2>
        <ul class="social-links">
          <li>
            <a href="https://x.com/vaidadehumana" rel="me">
              X ↗
            </a>
          </li>
          <li>
            <a href="https://letterboxd.com/pvca/" rel="me">
              Letterboxd ↗
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/paulovcaragao/" rel="me">
              Instagram ↗
            </a>
          </li>
          <li>
            <a href="https://rateyourmusic.com/~pvca" rel="me">
              Rate Your Music ↗
            </a>
          </li>
        </ul>
      </section>
    </div>
    <div class="wrap rule"></div>
    <section class="wrap section">
      <h2>{t("O acervo em números")}</h2>
      <CollectionStats />
    </section>
    <div class="wrap section tmdb-credit">
      <a href="https://www.themoviedb.org/" aria-label="TMDB">
        <img
          src={assetPath("/credits/tmdb.svg")}
          alt="TMDB"
          width="93"
          height="67"
          loading="lazy"
        />
      </a>
      <p>
        {t("Metadados e pôsteres obtidos do TMDB quando disponíveis.")}
        <br />
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tmdb-credit {
    display: flex;
    align-items: center;
    gap: 24px;
    border-top: 1px solid var(--color-border);
  }
  .tmdb-credit img {
    filter: grayscale(1) brightness(0) invert(1);
    max-width: none;
  }
  .tmdb-credit p {
    font-size: 0.875rem;
    color: #9f9d96;
  }
  @media (max-width: 600px) {
    .tmdb-credit {
      align-items: flex-start;
      gap: 16px;
    }
    .tmdb-credit img {
      width: 70px;
      height: auto;
    }
  }
</style>
