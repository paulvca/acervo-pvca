---
import {getI18n,localizeFilm} from '../lib/i18n';
const {lang,t,path}=getI18n(Astro.url);

import {isPreview} from '../data/catalog';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CollectionStats from '../components/CollectionStats.astro';
---
<BaseLayout title="Sobre — Acervo PVCA"><Header active="about" /><main id="main">
<section class="wrap page-head"><h1>{t("Sobre")}</h1><p>{t("Por que este acervo existe e o que exatamente aparece aqui.")}</p></section>
<section class="wrap about-intro"><p>{t("O Acervo PVCA começou como uma forma de organizar minha coleção pessoal de filmes. Com o tempo, passou a reunir diferentes cópias, legendas revisadas e metadados consistentes.")}</p><p>{t("Este site é uma forma de abrir parte da minha estante de cinema para outras pessoas explorarem. Você pode navegar pelos filmes, pesquisar títulos e conhecer tanto as obras quanto as cópias preservadas, sem expor a operação privada do acervo.")}</p></section>
<div class="wrap rule"></div><div class="wrap about-columns">
<section><h2>{t("O que aparece aqui")}</h2><p>{t("Título, ano, direção e informações sobre cada filme. Resolução, tamanho, formato, áudio e legendas pertencem à cópia selecionada para representar a obra.")}</p><p>{t("Seleções pessoais e notas editoriais ajudam a explorar a coleção. Links para Internet Archive ou Google Drive permitem chegar às cópias que escolhi compartilhar.")}{isPreview && t(' Nesta prévia, pôsteres e dados ainda não importados permanecem indicados como pendentes.')}</p></section>
<section><h2>{t("Como o acervo é organizado")}</h2><p>{t("Cada filme é tratado como uma obra. Diferentes cópias, versões ou edições são variantes dessa mesma obra, com seus próprios metadados técnicos.")}</p><p>{t("O catálogo apresenta a cópia escolhida para representar cada filme. Na ficha, você encontra suas características e, quando houver outras versões preservadas, as diferenças entre elas.")}</p></section>
<section><h2>{t("O que fica fora do site")}</h2><p>{t("Caminhos locais, mounts, hashes, logs, notas internas, filas, estados de QA, credenciais e informações privadas de armazenamento permanecem fora do site.")}</p><p>{t("O foco aqui é o conteúdo cinematográfico e as informações que ajudam na descoberta e no contexto dos filmes.")}</p></section>
</div><div class="wrap rule"></div><section class="wrap section"><h2>{t("O acervo em números")}</h2><CollectionStats /></section></main><Footer /></BaseLayout>
