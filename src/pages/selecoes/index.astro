---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { selections } from '../../data/selections';
---

<BaseLayout
  title="Seleções — Acervo PVCA"
  description="Agrupamentos pessoais e caminhos para atravessar o acervo."
>
  <Header active="selections" />

  <main>
    <section class="wrap page-head">
      <h1>Seleções</h1>
      <p>
        Agrupamentos pessoais. Alguns são bem definidos; outros só refletem o
        que estou vendo, revisando ou pensando no momento.
      </p>
    </section>

    <section class="wrap selection-list">
      {
        selections.map((selection) => (
          <article class="selection-row" id={selection.id}>
            <div class="selection-stack" aria-hidden="true">
              <i></i><i></i><i></i>
            </div>
            <div>
              <h2>{selection.title}</h2>
              <p>{selection.description}</p>
            </div>
            <div class="count">{selection.count}</div>
          </article>
        ))
      }
    </section>
  </main>

  <Footer />
</BaseLayout>
